# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Anthropic API Key (from console.anthropic.com)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Comma-separated Telegram user IDs allowed to use the bot
ALLOWED_TELEGRAM_USER_IDS=123456789

# Daily briefing time (24h format, Pacific time)
BRIEFING_HOUR=7
BRIEFING_MINUTE=0

# Claude model (default: claude-haiku-4-5-20251001)
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Logging level
LOG_LEVEL=INFO

# Optional: market insight for daily briefing (free tiers)
# Alpha Vantage: https://www.alphavantage.co/support/#api-key (25 req/day; MCP: https://mcp.alphavantage.co/)
# ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
# Finnhub: https://finnhub.io/register (60 calls/min, US market)
# FINNHUB_API_KEY=your-finnhub-token
